    "metadata": {
        "title": "Храни меня",
        "author": "Виталий Ефремочкин",
        "copyright": null,
        "ccli": null,
        "language": null,
        "tags": []
    },
    "sections": [
        {
            "id": "b9d01e5e-0b9c-49a3-b71e-d2f34f947391",
            "type": "VERSE",
            "number": 1,
            "slides": [
                {
                    "id": "e98e2165-27db-4c1d-a18e-5694557f4730",
                    "lines": [
                        "Ты испытал сердце мое,",
                        "Молитву мою услышал."
                    ],
                    "chords": [
                        "Ebm             Bbm/Db",
                        "    H             Abm   Bbsus4  Bb"
                    ]
                },
                {
                    "id": "76d3fe24-8c44-48f1-acaf-2fbb1a28ef13",
                    "lines": [
                        "Милость Свою ко мне Ты простер,",
                        "От тайных моих очистил."
                    ],
                    "chords": [
                        "Ebm                        Bbm/Db",
                        "    H                   Abm Bbsus4  Bb"
                    ]
                }
            ]
        },
        {
            "id": "70d6b11f-5556-4a70-9708-279213014eaa",
            "type": "CHORUS",
            "number": 1,
            "slides": [
                {
                    "id": "eee34129-0814-45cf-a817-7ece971f161f",
                    "lines": [
                        "Храни меня, Господь,",
                        "В руках Твоих не поколеблюсь."
                    ],
                    "chords": [
                        "                Ebm      Bbm/Db",
                        "                     H  Abm        Bbsus4  Bb"
                    ]
                },
                {
                    "id": "8624e2c4-52c9-4aa5-863b-8e643a5f51ea",
                    "lines": [
                        "Веди меня, Господь,",
                        "Всем сердцем я Тебе доверюсь."
                    ],
                    "chords": [
                        "                Ebm   Bbm/Db",
                        "                            H  Abm     Bbsus4  Bb"
                    ]
                }
            ]
        },
        {
            "id": "a3130196-883f-4982-8b39-e7cad948c2b2",
            "type": "TAG",
            "number": 1,
            "slides": [
                {
                    "id": "850f2a4f-af51-4ef6-8f9e-6e1657cab1bf",
                    "lines": [
                        "Тебе доверюсь."
                    ],
                    "chords": [
                        null
                    ]
                }
            ]
        },
        {
            "id": "a7743196-3b50-45c6-95c4-1a62c5df751e",
            "type": "VERSE",
            "number": 2,
            "slides": [
                {
                    "id": "d66b52a0-b0e3-4f7a-bc71-ee38c8b4430e",
                    "lines": [
                        "Кто убежит от лица Твоего?",
                        "От взора Святого не скрыться."
                    ],
                    "chords": [
                        "Ebm                      Bbm/Db",
                        "    H                   Abm       Bbsus4  Bb"
                    ]
                },
                {
                    "id": "86fafd30-c3e0-4b54-9c28-7520cb90bd14",
                    "lines": [
                        "Все пред Тобой, не утаить ничего,",
                        "Ты знаешь глубины сердец, Всевышний."
                    ],
                    "chords": [
                        "Ebm                                    Bbm/Db",
                        "    H                                     Abm        Bbsus4  Bb"
                    ]
                }
            ]
        },
        {
            "id": "8ad4b3ca-862c-49d3-abe7-66852e55c8e1",
